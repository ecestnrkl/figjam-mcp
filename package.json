{
  "name": "figjam-context-mcp",
  "version": "0.4.0",
  "description": "MCP server that turns a FigJam board into queryable context for LLMs",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    ".env.example",
    "docs/pipeline.gif",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "server.json"
  ],
  "bin": {
    "figjam-context-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "postbuild": "node scripts/postbuild.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck:src": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "typecheck": "npm run typecheck:src && npm run typecheck:tests",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && npm run package:check",
    "package:check": "node scripts/check-package.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "eval:retrieval": "node --import tsx scripts/evaluate-retrieval.mjs",
    "prepack": "npm run check",
    "security:check": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "dotenv": "^18.0.5",
    "openai": "^6.45.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.20.5",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "license": "MIT",
  "author": "ecestnrkl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecestnrkl/figjam-mcp.git"
  },
  "homepage": "https://github.com/ecestnrkl/figjam-mcp#readme",
  "bugs": {
    "url": "https://github.com/ecestnrkl/figjam-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "figjam",
    "figma",
    "knowledge",
    "ux-research"
  ],
  "mcpName": "io.github.ecestnrkl/figjam-mcp"
}
