# Figma personal access token
# figma.com → Settings → Security → Personal access tokens
# Scope: file_content:read. The token must have access to the requested board.
# Prefer environment credentials; tool arguments can appear in client logs.
FIGMA_ACCESS_TOKEN=

# --- LLM (vision interpretation + answer synthesis) ---------------------
# OpenAI-compatible chat completions endpoint. Model quotas/prices can change.
# Board text/images are sent to this provider for vision and Q&A; use max_speed
# and get_board_context for deterministic context without model calls.
#
# 1) OpenRouter (default): create a key at https://openrouter.ai/keys.
#    The student-free preset tries explicit free models and then the free
#    openrouter/free router. Availability and supported parameters can change.
#
# 2) GitHub Models: free with any GitHub account
#    (https://github.com/marketplace/models) — set
#    LLM_BASE_URL=https://models.github.ai/inference and use a GitHub PAT
#    as LLM_API_KEY, with a vision-capable model id.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Supported presets: student-free
LLM_MODEL_PRESET=student-free
# Optional role-specific overrides. Legacy LLM_VISION_MODEL / LLM_TEXT_MODEL
# still work and become the first candidate in each list.
# LLM_VISION_MODELS=google/gemma-4-26b-a4b-it:free,openrouter/free
# LLM_TEXT_MODELS=qwen/qwen3-next-80b-a3b-instruct:free,nvidia/nemotron-nano-9b-v2:free,openrouter/free
# LLM_FAST_TEXT_MODELS=nvidia/nemotron-nano-9b-v2:free,liquid/lfm-2.5-1.2b-instruct:free
# LLM_PROVIDER_REQUIRE_PARAMETERS=true

# --- Timeout controls ----------------------------------------------------
# Defaults are tuned so MCP UI clients do not wait forever on slow providers.
# Increase these only if your MCP client/request timeout is also higher.
# FIGMA_REQUEST_TIMEOUT_MS=15000
# FIGMA_FILE_REQUEST_TIMEOUT_MS=60000
# LLM_REQUEST_TIMEOUT_MS=20000
# LLM_SDK_MAX_RETRIES=0
# LLM_RATE_LIMIT_RETRIES=1
# LLM_RATE_LIMIT_MAX_BACKOFF_MS=5000
# LLM_MAX_OUTPUT_TOKENS=14096
# LLM_ANSWER_MAX_OUTPUT_TOKENS=2048
# LLM_VISION_MAX_OUTPUT_TOKENS=4096
# LLM_ANSWER_TOP_K=6
# LLM_ANSWER_PROMPT_MAX_CHARS=24000
# INGEST_BOARD_VISION_BUDGET_MS=35000
# INGEST_BOARD_MIN_VISION_SLOT_MS=10000
# INGEST_BOARD_VISION_CONCURRENCY=3
# FIGMA_SCREENSHOT_DOWNLOAD_CONCURRENCY=3

# --- Cache controls ------------------------------------------------------
# Maximum full boards retained in process memory. Older entries remain on
# disk and are restored on demand.
# FIGJAM_MCP_MEMORY_CACHE_MAX_BOARDS=10

# Private cache root (v4/ is created beneath it). Omit for the per-user OS default.
# macOS: ~/Library/Caches/figjam-context-mcp
# Windows: %LOCALAPPDATA%/figjam-context-mcp
# Linux: $XDG_CACHE_HOME/figjam-context-mcp or ~/.cache/figjam-context-mcp
# Use an absolute dedicated directory, not a shared project directory.
# FIGJAM_MCP_CACHE_DIR=/absolute/private/path/figjam-context-mcp
# Legacy v3 data is preserved; re-ingest boards to populate v4.
